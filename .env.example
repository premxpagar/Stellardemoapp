# Stellar Grove: Knights of the Astral Rift — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials.

# Supabase (optional — game works without it using localStorage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stellar Network
VITE_STELLAR_NETWORK=testnet

# Soroban Contract (optional — set after deploying the companion provenance contract)
VITE_STELLAR_CONTRACT_ID=
